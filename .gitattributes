# 统一换行符，避免 Windows / macOS / Linux 协作时整文件 diff
* text=auto eol=lf

# 二进制资源（不做文本转换、不显示 diff）
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.so binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
*.zip binary

# 脚本按平台保留换行符
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
gradlew text eol=lf
